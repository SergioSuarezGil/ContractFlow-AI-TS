# =============================================================================
# ContractFlow AI — environment template (twin of .env)
# Copy to .env and adjust. `.env` is gitignored — never commit it.
# Values below are LOCAL DEMO defaults for Docker Compose only.
# =============================================================================

# --- General ---
NODE_ENV=development
LLM_PROVIDER=mock

# --- Contracts API ---
CONTRACTS_API_PORT=3000
CONTRACTS_API_HOST=0.0.0.0

# --- Workers (HTTP health endpoints) ---
AI_WORKER_PORT=3001
PDF_WORKER_PORT=3002

# --- MongoDB ---
MONGODB_URI=mongodb://mongodb:27017/contractflow?directConnection=true
MONGODB_DB=contractflow

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=contractflow
RABBITMQ_DEFAULT_PASS=contractflow
RABBITMQ_URL=amqp://contractflow:contractflow@rabbitmq:5672
RABBITMQ_EXCHANGE=contractflow.events

# --- Object storage (S3-compatible; LocalStack in local Compose) ---
S3_ENDPOINT=object-storage
S3_PORT=4566
S3_USE_SSL=false
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_REPORTS=reports
# Legacy aliases (same LocalStack endpoint)
MINIO_ENDPOINT=object-storage
MINIO_PORT=4566
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_REPORTS=reports

# --- Auth ---
# oidc = validate Bearer JWT (default in Docker)
# dev  = accept X-Owner-Id / X-Household-Id headers (local debugging only)
AUTH_MODE=oidc
DEV_OWNER_ID=demo
DEV_HOUSEHOLD_ID=hh_demo

# --- Keycloak / OIDC (API) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=contractflow
KEYCLOAK_CLIENT_ID=contractflow-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://localhost:8080/realms/contractflow
OIDC_JWKS_URI=http://keycloak:8080/realms/contractflow/protocol/openid-connect/certs
OIDC_AUDIENCE=contractflow-web

# --- Web demo (Vite; redirect URIs are runtime-derived from window.location.origin) ---
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/contractflow
VITE_OIDC_CLIENT_ID=contractflow-web
VITE_API_BASE=

# --- Demo users (Keycloak realm import; local only) ---
# Username: demo / Password: demo  (household_id claim: hh_demo)
# API confidential client secret (realm JSON): contractflow-api-secret

# --- gRPC (sync health / future RPCs) ---
AI_WORKER_GRPC_URL=0.0.0.0:50051
AI_WORKER_GRPC_TARGET=ai-worker:50051
GRPC_HEALTH_CHECK=true

# --- Observability (optional compose.observability.yaml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Host ports (reference) ---
# API http://localhost:3000  · OpenAPI UI /docs  · metrics /metrics
# AI worker http://localhost:3001/health · gRPC :50051
# PDF worker http://localhost:3002/health
# Web demo http://localhost:8088
# MongoDB localhost:27017
# RabbitMQ AMQP localhost:5672 / UI localhost:15672
# S3 (LocalStack) localhost:4566
# Keycloak localhost:8080
# Prometheus localhost:9090 · Grafana localhost:3003
