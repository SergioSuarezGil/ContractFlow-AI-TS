    "/api/v1/contracts/{contractId}/documents": {
      "get": {
        "operationId": "DocumentsController_list",
        "parameters": [
          {
            "name": "contractId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContractDocumentResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List documents for a contract",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Allowed types: PDF, Excel (.xlsx/.xls), CSV, Markdown (.md), plain text (.txt), Word (.docx). Max 15 MB.",
        "operationId": "DocumentsController_upload",
        "parameters": [
          {
            "name": "contractId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "role"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "pdf, xlsx, xls, csv, md, txt, docx"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "current",
                      "proposal"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractDocumentResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload a current or proposal document",
        "tags": [
          "documents"
        ]
      }
    },
