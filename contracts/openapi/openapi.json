  "info": {
    "title": "ContractFlow AI — Contracts API",
    "description": "REST API for personal service contracts, documents, comparison jobs, and reports.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "contracts",
      "description": ""
    },
    {
      "name": "documents",
      "description": ""
    },
    {
      "name": "comparisons",
      "description": ""
    },
    {
      "name": "jobs",
      "description": ""
    },
    {
      "name": "reports",
      "description": ""
    },
    {
      "name": "health",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Keycloak access token (realm contractflow)"
      }
    },
    "schemas": {
      "CreateContractDto": {
        "type": "object",
        "properties": {
          "serviceType": {
            "type": "string",
            "enum": [
              "electricity",
              "gas",
              "insurance",
              "mobile",
              "internet",
              "other"
            ]
          },
          "providerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "serviceType",
          "providerName",
          "title"
        ]
      },
      "ServiceContractResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "serviceType": {
            "type": "string",
            "enum": [
              "electricity",
              "gas",
              "insurance",
              "mobile",
              "internet",
              "other"
            ]
          },
          "providerName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          },
          "currentDocumentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposalDocumentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "householdId",
          "ownerId",
          "serviceType",
          "providerName",
          "title",
          "notes",
          "status",
          "currentDocumentIds",
          "proposalDocumentIds",
          "createdAt",
          "updatedAt",
          "version"
        ]
      },
      "UpdateContractDto": {
        "type": "object",
        "properties": {
          "serviceType": {
            "type": "string",
            "enum": [
              "electricity",
              "gas",
              "insurance",
              "mobile",
              "internet",
              "other"
            ]
          },
          "providerName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "under_review"
            ]
          }
        }
      },
      "ContractDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contractId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "current",
              "proposal"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "contractId",
          "role",
          "fileName",
          "contentType",
          "sizeBytes",
          "createdAt"
        ]
      },
      "ComparisonAcceptedDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status"
        ]
      },
      "JobResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "contractId": {
            "type": "string",
            "format": "uuid"
          },
          "comparisonId": {
            "type": "string",
            "format": "uuid"
          },
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "errorMessage": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "contractId",
          "updatedAt"
        ]
      },
      "ReportResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "contractId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jobId",
          "contractId",
          "fileName",
          "createdAt"
        ]
      }
    }
  }
}