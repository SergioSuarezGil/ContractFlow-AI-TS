# syntax=docker/dockerfile:1.7
# Build from repository root:
#   docker build -f infra/docker/Dockerfile.web -t contractflow-web-demo .

FROM node:22-alpine AS build
WORKDIR /repo
# Do NOT bake redirect URIs here — they are derived from window.location.origin at runtime
# so localhost vs 127.0.0.1 both work with Keycloak.
ARG VITE_OIDC_AUTHORITY=http://localhost:8080/realms/contractflow
ARG VITE_OIDC_CLIENT_ID=contractflow-web
ARG VITE_API_BASE=
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_API_BASE=$VITE_API_BASE \
    VITE_APP_GIT_SHA=$GIT_SHA \
    VITE_APP_BUILD_TIME=$BUILD_TIME
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web-demo/package.json apps/web-demo/
RUN pnpm install --frozen-lockfile --filter @contractflow/web-demo...
COPY apps/web-demo apps/web-demo
WORKDIR /repo/apps/web-demo
RUN pnpm run build

FROM nginx:1.27-alpine AS runner
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="contractflow-web-demo" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      com.contractflow.service="web-demo" \
      com.contractflow.git_sha="${GIT_SHA}"
COPY apps/web-demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web-demo/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
