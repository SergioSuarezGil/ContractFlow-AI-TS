{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contractflow.local/schemas/grafana-datasource.schema.json",
  "title": "Grafana datasource provisioning",
  "type": "object",
  "required": ["apiVersion", "datasources"],
  "additionalProperties": true,
  "properties": {
    "apiVersion": {
      "oneOf": [{ "type": "integer" }, { "type": "string" }]
    },
    "deleteDatasources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "uid": { "type": "string" },
          "access": { "type": "string", "enum": ["proxy", "direct"] },
          "url": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "editable": { "type": "boolean" },
          "orgId": { "type": "integer" },
          "jsonData": { "type": "object" },
          "secureJsonData": { "type": "object" }
        }
      }
    }
  }
}
